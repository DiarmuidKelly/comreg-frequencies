{
  "name": "comreg-freq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive explorer for the Radio Frequency Plan for Ireland (ComReg RFPI)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-data.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fetch:raw": "node scripts/fetch-data.mjs",
    "build:data": "node scripts/build-data.mjs",
    "data": "npm run fetch:raw && npm run build:data"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
